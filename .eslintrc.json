{
  "parser": "@typescript-eslint/parser",
  "plugins": ["@typescript-eslint"],
  "extends": [
    "eslint:recommended", 
    "plugin:@typescript-eslint/recommended"],
  "rules": {
    "@typescript-eslint/no-var-requires": "off",
    "no-multiple-empty-lines": ["error", { "max": 2, "maxBOF": 0, "maxEOF": 1 }],
    "quotes": ["error", "single"],
    "semi": ["error", "always"]
  }
}