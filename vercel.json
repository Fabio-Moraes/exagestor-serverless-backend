{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/socket.io",
      "dest": "src/index.ts",
      "headers": {
        "Upgrade": "websocket"
      }
    },
    {
      "src": "(.*)",
      "dest": "src/index.ts"
    }
  ]
}